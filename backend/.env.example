# =================================================================
# School Management System - Environment Configuration Template
# NOTE: Copy this file to .env and configure with your local secrets.
# Do NOT commit production secrets to version control.
# =================================================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=school_admin
DB_PASSWORD=your_strong_mysql_password_here
DB_NAME=school_management

# Optional full database URL override (e.g. mysql+pymysql://user:pass@host:3306/dbname)
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# JWT Secret & Cryptography Configuration
# Generate a secure 32+ character key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Environment (development / production / testing)
ENVIRONMENT=development
API_PREFIX=/api
PROJECT_NAME="Oakridge School Management API"
VERSION="1.0.0"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
